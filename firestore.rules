rules_version = '2';

// Cabadra — Firestore security rules.
//
// Mirrors the permission model in lib/tenancy.js, which is exhaustively unit
// tested. When you change one, change the other: the tests describe intent,
// these rules enforce it, and they must not disagree.
//
// THE MODEL
//   orgs/{orgId}                      Enterprise only; one implicit org otherwise
//   brands/{brandId}                  subscription, master menu, memberships
//     members/{uid}                   brand_owner | brand_manager | outlet_manager
//   restaurants/{outletId}            UNCHANGED PATH — orders, tables, QR target
//     staff/{uid}                     reception | kitchen
//
// TWO THREAT MODELS, KEPT SEPARATE
//   1. The diner's table client is UNAUTHENTICATED. It is a public page opened
//      from a QR code with the outlet id and table number in the URL, so anyone
//      can edit that URL. Assume an anonymous stranger lying about their table.
//   2. Staff are authenticated but scoped. A Bandra manager must not reach
//      Andheri, and nobody may grant themselves a role above their own.
//
// BOOTSTRAP ORDER MATTERS. Signup writes brand -> membership -> outlet -> info.
// Every step below is reachable in that order; an earlier version of this file
// required staff membership before the membership document existed, which broke
// account creation entirely. Do not reorder without re-checking.
//
// Deploy:  firebase deploy --only firestore:rules,firestore:indexes

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helpers
    // =====================================================================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // -------------------------------------------------------------------
    // Two kinds of signed-in
    // -------------------------------------------------------------------
    //
    // Staff sign in with a password or Google. Diners, once phone verification
    // is switched on, sign in with an SMS code -- and that gives them a real
    // request.auth too. Every rule that only asked "is ANYONE signed in?" would
    // therefore start saying yes to strangers: a diner could create a brand, or
    // an org, and land themselves in the approvals queue as junk.
    //
    // So the two are kept apart by the provider that issued the token, which no
    // client can forge. Staff-facing rules ask isStaffAuth(); the diner ones ask
    // isVerifiedDiner().

    function signInProvider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function isStaffAuth() {
      return signedIn() && signInProvider() != 'phone';
    }

    function isVerifiedDiner() {
      return signedIn()
        && signInProvider() == 'phone'
        && 'phone_number' in request.auth.token
        && request.auth.token.phone_number != '';
    }

    // The number Firebase itself verified -- not one the client claims.
    function dinerPhone() {
      return request.auth.token.phone_number;
    }

    // The platform operator. Seeded by hand in the console; writable by nobody,
    // so no client can ever promote itself into approving its own subscription.
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(uid()));
    }

    function brandDoc(brandId) {
      return get(/databases/$(database)/documents/brands/$(brandId)).data;
    }

    function isBrandCreator(brandId) {
      return signedIn()
        && exists(/databases/$(database)/documents/brands/$(brandId))
        && brandDoc(brandId).ownerUid == uid();
    }

    function hasBrandMembership(brandId) {
      return signedIn()
        && exists(/databases/$(database)/documents/brands/$(brandId)/members/$(uid()));
    }

    function brandRole(brandId) {
      return get(/databases/$(database)/documents/brands/$(brandId)/members/$(uid())).data.role;
    }

    // Owner reaches everything in the brand. isBrandCreator is the bootstrap
    // path: during signup the membership document does not exist yet.
    function isBrandOwner(brandId) {
      return isBrandCreator(brandId)
        || (hasBrandMembership(brandId) && brandRole(brandId) == 'brand_owner');
    }

    function brandMemberOutlets(brandId) {
      return get(/databases/$(database)/documents/brands/$(brandId)/members/$(uid())).data.get('outletIds', []);
    }

    // Which brand an outlet belongs to.
    function outletBrandId(outletId) {
      return get(/databases/$(database)/documents/restaurants/$(outletId)).data.get('brandId', null);
    }

    // Reception / kitchen are rostered on the outlet itself.
    function isOutletStaff(outletId) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurants/$(outletId)/staff/$(uid()));
    }

    // Full management of one outlet: brand owner, or an outlet manager whose
    // assignment list contains it. Mirrors canAccessOutlet() in lib/tenancy.js.
    function canManageOutlet(outletId) {
      // brandMemberOutlets takes a BRAND id. An earlier version passed the
      // outlet id here, which resolved brands/{outletId}/members/{uid} -- a
      // document that never exists -- so the whole clause failed and no outlet
      // manager could manage anything at all, including their own outlet.
      return signedIn() && (
        isBrandOwner(outletBrandId(outletId))
        || (hasBrandMembership(outletBrandId(outletId))
            && brandRole(outletBrandId(outletId)) == 'outlet_manager'
            && outletId in brandMemberOutlets(outletBrandId(outletId)))
      );
    }

    // Anyone entitled to see an outlet's operational data — managers above it
    // plus the floor staff rostered on it.
    function canWorkOutlet(outletId) {
      return isOutletStaff(outletId) || canManageOutlet(outletId);
    }

    // Read-only oversight across a whole brand.
    function canReadBrand(brandId) {
      return isBrandOwner(brandId)
        || (hasBrandMembership(brandId) && brandRole(brandId) in ['brand_manager', 'outlet_manager']);
    }

    // An invitation addressed to the signed-in user's own email address.
    //
    // This is what lets someone create their OWN membership: the invite was
    // written by a person who already held those outlets, so accepting it grants
    // nothing that was not already granted. Keyed by the plain lowercased email
    // so there is no key-mangling scheme to keep in sync with the client.
    function hasInvite() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower()));
    }

    function myInvite() {
      return get(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower())).data;
    }

    // -------------------------------------------------------------------
    // Table sessions
    // -------------------------------------------------------------------
    //
    // A QR code encodes ?restaurant=<outletId>&table=3. Both are guessable, so
    // an order could be placed from anywhere, or onto somebody else's table by
    // changing one digit.
    //
    // tableSecrets/{table} holds a random token that NO client can read — the
    // rule reads it with get(), which the client cannot do. The token travels
    // in the QR code and comes back on the order, so the diner proves they know
    // it without ever being able to look it up.
    //
    // Protection turns on PER TABLE, the moment a secret exists for it. That
    // makes this a migration rather than a flag day: a table is protected as
    // soon as its new QR code is printed, and tables still showing an old code
    // keep working until they are reprinted.

    function tableKey() {
      return string(request.resource.data.table);
    }

    function tableIsProtected(outletId) {
      return exists(/databases/$(database)/documents/restaurants/$(outletId)/tableSecrets/$(tableKey()));
    }

    function tableTokenMatches(outletId) {
      return request.resource.data.get('tableToken', '') != ''
        && get(/databases/$(database)/documents/restaurants/$(outletId)/tableSecrets/$(tableKey())).data.token
           == request.resource.data.tableToken;
    }

    // An open, unexpired session. This is what stops an order arriving for a
    // table nobody is sitting at, or hours after the guests left.
    function tableSessionOpen(outletId) {
      return exists(/databases/$(database)/documents/restaurants/$(outletId)/tableSessions/$(tableKey()))
        && get(/databases/$(database)/documents/restaurants/$(outletId)/tableSessions/$(tableKey())).data.open == true
        && get(/databases/$(database)/documents/restaurants/$(outletId)/tableSessions/$(tableKey())).data.get('expiresAt', 0)
           > request.time.toMillis();
    }

    // A diner may place this order: either the table is not yet protected (its
    // QR has not been reprinted), or they hold its token AND it is seated.
    function dinerMayOrderAt(outletId) {
      return !tableIsProtected(outletId)
        || (tableTokenMatches(outletId) && tableSessionOpen(outletId));
    }

    function isDeliveryOrder() {
      return request.resource.data.get('orderType', '') == 'delivery';
    }

    // -------------------------------------------------------------------
    // Delivery
    // -------------------------------------------------------------------
    //
    // Delivery is the LEGITIMATE way to order without being in the restaurant.
    // It therefore cannot require a table token, which makes it the one path a
    // stranger can write to — so it carries its own conditions instead.
    //
    // The details document is written first, under the order's own id, and the
    // order is only accepted if it exists. That is what stops an order arriving
    // with nowhere to deliver it.

    function deliveryEnabled(outletId) {
      return exists(/databases/$(database)/documents/restaurants/$(outletId)/info/settings)
        && get(/databases/$(database)/documents/restaurants/$(outletId)/info/settings).data.get('deliveryEnabled', false) == true;
    }

    // Verification costs money per SMS, so it is a per-outlet choice rather
    // than a platform-wide one. Absent means off, which is what keeps every
    // existing outlet working exactly as it does today.
    function requiresPhoneVerification(outletId) {
      return exists(/databases/$(database)/documents/restaurants/$(outletId)/info/settings)
        && get(/databases/$(database)/documents/restaurants/$(outletId)/info/settings).data.get('requirePhoneVerification', false) == true;
    }

    function hasDeliveryDetails(outletId, orderId) {
      return exists(/databases/$(database)/documents/restaurants/$(outletId)/deliveryDetails/$(orderId));
    }

    function dinerMayOrderForDelivery(outletId, orderId) {
      return deliveryEnabled(outletId) && hasDeliveryDetails(outletId, orderId);
    }

    function pendingStatus(status) {
      return status in ['pending_payment', 'pending_approval'];
    }

    // Fields a diner may set when placing an order. Anything else — a status
    // jump, a bill total, a discount — must come from staff.
    function dinerOrderFieldsOnly() {
      return request.resource.data.keys().hasOnly([
        'table', 'items', 'status', 'orderType', 'isVIP',
        'etaMinutes', 'preparingAt', 'createdAt', 'notes', 'tableToken'
      ]);
    }

    // =====================================================================
    // Platform
    // =====================================================================

    match /platformAdmins/{adminUid} {
      allow read: if signedIn() && uid() == adminUid;
      allow write: if false; // console only, by hand
    }

    // A routing hint, never an authority. The subject can edit this document,
    // so no rule anywhere may branch on its contents.
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId;
      allow update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // Every subscription decision the platform operator makes — approve,
    // reject, suspend, extend — with who did it and why.
    //
    // APPEND-ONLY, including for platform admins. Create is allowed; update and
    // delete are denied to everyone, with no exception and no override. A log
    // its own operator can rewrite is not evidence of anything, and the point of
    // keeping it is to have something quotable when a customer disputes a bill.
    match /auditLog/{entryId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
                    && request.resource.data.actorUid == uid();
      allow update, delete: if false;
    }

    // Legacy subscription documents from before brands existed.
    //
    // The rules rewrite dropped this collection entirely, which meant
    // /setup/migrate could not read the subscription it is supposed to carry
    // across: the read failed, the catch swallowed it, and a migrated account
    // silently reverted to pending_approval — an active paying customer would
    // have been locked out and sent back to the approvals queue.
    //
    // Read-only, and only by the account it belongs to. Nothing writes here any
    // more; the collection can be deleted once every account has migrated.
    match /hotels/{legacyId} {
      allow read: if isPlatformAdmin() || (signedIn() && uid() == legacyId);
      allow write: if false;
    }

    match /orgs/{orgId} {
      allow read: if isPlatformAdmin()
                  || (signedIn() && resource.data.get('ownerUid', '') == uid());
      // isStaffAuth, not signedIn: a verified diner holds a token too, and
      // without this could file an org nobody asked for.
      allow create: if isStaffAuth() && request.resource.data.ownerUid == uid();
      allow update, delete: if isPlatformAdmin();
    }

    // =====================================================================
    // Brands
    // =====================================================================

    match /brands/{brandId} {
      // Platform admin reads every brand — that is the approvals queue, served
      // by one collection query rather than a lookup per brand.
      allow read: if isPlatformAdmin() || canReadBrand(brandId);

      // Signup. The creator must name themselves as owner and may only submit
      // into a pending state, so nobody can self-activate a paid plan.
      allow create: if isStaffAuth()
                    && request.resource.data.ownerUid == uid()
                    && pendingStatus(request.resource.data.subscription.status);

      // Two writers, deliberately different:
      //   owner — may re-submit while pending / rejected / expired, and may
      //           edit brand details, but can never write an active status,
      //           change tier, or move the expiry date.
      //   platform admin — may set anything, once payment is verified.
      // Three distinct writers:
      //
      //   1. Platform admin — anything, once payment is verified.
      //   2. Owner managing their own brand — renaming it, adding an outlet to
      //      outletIds. They may NOT touch subscription, tier, or ownerUid, so
      //      running a brand can never become a way to upgrade its plan.
      //   3. Owner re-submitting a signup that was rejected or has lapsed, which
      //      does write subscription but only ever into a pending state.
      allow update: if isPlatformAdmin()
                    || (isBrandOwner(brandId)
                        && request.resource.data.subscription == resource.data.subscription
                        && request.resource.data.tier == resource.data.tier
                        && request.resource.data.ownerUid == resource.data.ownerUid)
                    || (isBrandOwner(brandId)
                        && pendingStatus(request.resource.data.subscription.status)
                        && resource.data.subscription.status in ['pending_payment', 'pending_approval', 'rejected', 'expired']
                        && request.resource.data.tier == resource.data.tier
                        && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isPlatformAdmin();

      // --- memberships -------------------------------------------------
      match /members/{memberUid} {
        allow read: if isPlatformAdmin()
                    || (signedIn() && uid() == memberUid)
                    || canReadBrand(brandId);

        // Three ways a membership comes into being:
        //
        //   1. Bootstrap — the brand creator writes their own owner membership
        //      during signup, before any other document exists.
        //   2. An owner adds someone directly.
        //   3. An invited person accepts, creating their OWN membership from an
        //      invitation addressed to their email. The role and the outlet list
        //      must match the invite exactly, so accepting cannot grant more
        //      than was offered.
        //
        // Nobody may create another brand_owner: ownership transfer is a
        // platform-admin operation on purpose.
        allow create: if (isBrandCreator(brandId)
                          && uid() == memberUid
                          && request.resource.data.role == 'brand_owner')
                      || (isBrandOwner(brandId)
                          && request.resource.data.role in ['brand_manager', 'outlet_manager'])
                      || (uid() == memberUid
                          && hasInvite()
                          && myInvite().active == true
                          && myInvite().brandId == brandId
                          && myInvite().role == request.resource.data.role
                          && request.resource.data.role in ['brand_manager', 'outlet_manager']
                          && request.resource.data.outletIds == myInvite().outletIds);

        // An owner changes someone's role or outlet assignment. A member edits
        // their OWN name and phone and nothing else -- role and outletIds are
        // pinned to their current values, so self-service profile editing can
        // never become self-promotion.
        allow update: if (isBrandOwner(brandId)
                          && request.resource.data.role in ['brand_manager', 'outlet_manager'])
                      || (uid() == memberUid
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.outletIds == resource.data.outletIds
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['name', 'phone', 'email']));

        allow delete: if isBrandOwner(brandId) && uid() != memberUid;
      }

      // --- master menu --------------------------------------------------
      // Public read: the diner's table client resolves the effective menu as
      // master ⊕ outlet override, so it must be able to read the master.
      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if isBrandOwner(brandId);
      }
    }

    // =====================================================================
    // Staff invitations
    // =====================================================================
    //
    // An invitation carries the scope of the grant and who issued it, so the
    // rule can verify the inviter actually held what they gave away. Without
    // outletIds on the document, a Bandra manager could invite a colleague
    // into Andheri.

    match /staffInvites/{emailKey} {
      // A person may read the invitation addressed to them, and anyone who can
      // manage the brand may read the ones they issued. Scoping this to the
      // caller's own email means an invite list is not a harvestable directory
      // of every restaurant's staff.
      // A person always reads the invitation addressed to them. Anyone with
      // brand-level oversight reads the ones issued for their own brand, which
      // is what makes the pending-invites list work for managers as well as
      // owners. Scoping to the caller's own email means the collection is not a
      // harvestable directory of every restaurant's staff.
      allow read: if isPlatformAdmin()
                  || (signedIn() && request.auth.token.email != null
                      && emailKey == request.auth.token.email.lower())
                  || (signedIn() && canReadBrand(resource.data.brandId));

      allow create, update: if signedIn()
                            && request.resource.data.outletIds.size() > 0
                            && (
                              // Owner may invite managers or floor staff anywhere in the brand.
                              (isBrandOwner(request.resource.data.brandId)
                               && request.resource.data.role in ['brand_manager', 'outlet_manager', 'reception', 'kitchen'])
                              // An outlet manager may invite floor staff only, and only for
                              // outlets they themselves hold.
                              || (hasBrandMembership(request.resource.data.brandId)
                                  && brandRole(request.resource.data.brandId) == 'outlet_manager'
                                  && request.resource.data.role in ['reception', 'kitchen']
                                  && request.resource.data.outletIds.hasOnly(brandMemberOutlets(request.resource.data.brandId)))
                            );

      // The invitee marks their OWN invitation consumed once they have accepted
      // it. They may flip active from true to false and stamp who and when --
      // nothing else. Without this the invitation stays listed as outstanding
      // forever, and the person appears simultaneously as a member and as
      // somebody who has not signed in yet.
      allow update: if signedIn()
                    && request.auth.token.email != null
                    && emailKey == request.auth.token.email.lower()
                    && resource.data.active == true
                    && request.resource.data.active == false
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['active', 'acceptedAt', 'acceptedByUid']);

      allow delete: if signedIn() && isBrandOwner(resource.data.brandId);
    }

    // =====================================================================
    // Outlets
    // =====================================================================

    match /restaurants/{outletId} {

      // The outlet document itself. Public read: the diner's client needs the
      // brandId to resolve the master menu.
      allow read: if true;
      allow create: if signedIn() && isBrandOwner(request.resource.data.brandId);

      // An outlet can never be moved between brands from a client — that would
      // let someone graft their outlet onto a brand they do not own.
      //
      // The second clause is the one-time migration path off the old model,
      // where a restaurant's id WAS its owner's uid. It is self-limiting: it
      // only applies while brandId is absent, so it cannot fire twice, and only
      // for the user whose uid matches the outlet id.
      allow update: if (canManageOutlet(outletId)
                        && request.resource.data.brandId == resource.data.brandId)
                    || (signedIn() && uid() == outletId
                        && !('brandId' in resource.data)
                        && 'brandId' in request.resource.data);

      allow delete: if signedIn() && isBrandOwner(resource.data.get('brandId', ''));

      // --- diner-facing, public read -----------------------------------
      match /menuOverrides/{itemId} {
        allow read: if true;
        allow write: if canManageOutlet(outletId);
      }
      match /menuItems/{itemId} {
        allow read: if true;
        allow write: if canManageOutlet(outletId);
      }
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if canManageOutlet(outletId);
      }
      match /offerBanners/{bannerId} {
        allow read: if true;
        allow write: if canManageOutlet(outletId);
      }
      match /bundleRules/{ruleId} {
        allow read: if true;
        allow write: if canManageOutlet(outletId);
      }
      match /tables/{tableId} {
        allow read: if true;
        allow write: if canWorkOutlet(outletId);
      }
      match /floors/{floorId} {
        allow read: if true;
        allow write: if canManageOutlet(outletId);
      }

      // profile and settings are public (name, logo, veg flag, review link).
      // billing holds the outlet's UPI id and tax configuration — staff only.
      match /info/{docId} {
        allow read: if docId != 'billing' || canWorkOutlet(outletId);
        allow write: if canManageOutlet(outletId);
      }

      // --- orders --------------------------------------------------------
      //
      // Reads stay open: the diner's client polls its own table's status and
      // there is no diner identity to scope by. Two things keep that tolerable
      // — the client query is bounded to the current sitting (lib/orders.js),
      // and customer name and phone are NOT on the order document; they live in
      // billCustomers below, which is staff-only.
      //
      // TODO (next): require an open tableSessions/{table} document for order
      // creation, so an order cannot be placed from outside the restaurant or
      // onto a table that is not seated. Pure rules, no server needed.
      match /orders/{orderId} {
        allow read: if true;

        allow create: if canWorkOutlet(outletId)
                      || (dinerOrderFieldsOnly()
                          && request.resource.data.status in ['pending', 'bill_requested']
                          && request.resource.data.items.size() > 0
                          && (isDeliveryOrder()
                              ? dinerMayOrderForDelivery(outletId, orderId)
                              : dinerMayOrderAt(outletId)));

        // A diner may move their own order between diner-owned states while it
        // is unbilled, and may attach a rating once, after payment. Everything
        // else — bill totals, discounts, status jumps — is staff only.
        allow update: if canWorkOutlet(outletId)
                      || (resource.data.status in ['pending', 'served']
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['items', 'status'])
                          && request.resource.data.status in ['pending', 'bill_requested', 'merged'])
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
                          && !('rating' in resource.data));

        allow delete: if canManageOutlet(outletId);
      }

      // Where a delivery order is going.
      //
      // Kept off the order document deliberately. Orders are publicly readable
      // so a diner can track their own, and if the address and phone lived
      // there, every guessed order id would be a lookup for somebody's home
      // address. Written once by the customer, read only by the outlet's staff,
      // and never rewritable — otherwise an address could be changed after the
      // kitchen had already started.
      match /deliveryDetails/{orderId} {
        // Staff working the outlet, or -- once verification is on -- the diner
        // whose own number is on the record. The second clause is what lets a
        // customer recover their order after a refresh without opening every
        // other customer's address to them.
        allow read: if canWorkOutlet(outletId)
                    || (isVerifiedDiner()
                        && resource.data.get('phoneE164', '') == dinerPhone());

        // phoneE164 must be the number Firebase verified, not one the client
        // typed. Comparing against the token is the entire point: otherwise a
        // diner verifies their own phone and files an order under someone
        // else's, which is the abuse this was built to stop.
        allow create: if request.resource.data.get('name', '') != ''
                      && request.resource.data.get('phone', '') != ''
                      && request.resource.data.get('address', '') != ''
                      && (
                        !requiresPhoneVerification(outletId)
                        || (isVerifiedDiner()
                            && request.resource.data.get('phoneE164', '') == dinerPhone())
                      );

        allow update, delete: if canWorkOutlet(outletId);
      }

      // The token behind each table's QR code.
      //
      // READ BY NOBODY. Not the diner, not the restaurant's own staff. A rule
      // can still read it with get(), which is the entire mechanism: the client
      // proves it knows the token without being able to look it up. Staff write
      // these when generating QR codes; nothing ever reads them back.
      match /tableSecrets/{tableNo} {
        allow read: if false;
        allow write: if canWorkOutlet(outletId);
      }

      // Whether a table is currently seated and taking orders.
      //
      // Deliberately readable: it holds nothing secret, and a diner whose order
      // is refused deserves to be told their table is closed rather than shown
      // a bare error. Only staff can open, extend or close one — a diner able
      // to open their own session would defeat the point of requiring one.
      match /tableSessions/{tableNo} {
        allow read: if true;
        allow write: if canWorkOutlet(outletId);
      }

      // --- staff only ----------------------------------------------------

      // Exists precisely so bill-time PII is unreachable from the public
      // table client.
      match /billCustomers/{billId} {
        allow read, write: if canWorkOutlet(outletId);
      }

      match /customers/{customerId} {
        allow read, write: if canWorkOutlet(outletId);
      }

      match /waiterCalls/{callId} {
        allow read: if true;
        allow create: if true; // a diner raises these
        allow update, delete: if canWorkOutlet(outletId);
      }

      // The roster.
      //
      // A person may create their OWN staff document only when an invitation
      // addressed to their email grants that role at THIS outlet. The previous
      // version allowed any signed-in user to roster themselves anywhere, which
      // meant anyone with an account could add themselves as reception at any
      // restaurant in the system.
      match /staff/{staffUid} {
        allow read: if canWorkOutlet(outletId);
        allow create: if canManageOutlet(outletId)
                      || (uid() == staffUid
                          && hasInvite()
                          && myInvite().active == true
                          && myInvite().role == request.resource.data.role
                          && request.resource.data.role in ['reception', 'kitchen']
                          && outletId in myInvite().outletIds);
        allow update: if canManageOutlet(outletId)
                      || (uid() == staffUid
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['name', 'phone', 'email']));
        allow delete: if canManageOutlet(outletId);
      }

      // Pre-aggregated rollups and recommendation models. Written by a trusted
      // batch job using the Admin SDK, which bypasses these rules entirely;
      // clients only ever read them.
      match /dailyStats/{dayId} {
        allow read: if canWorkOutlet(outletId);
        allow write: if false;
      }
      match /recModels/{modelId} {
        allow read: if true; // the diner's client scores recommendations locally
        allow write: if false;
      }
      match /recEvents/{eventId} {
        allow read: if canManageOutlet(outletId);
        allow create: if true; // impression / add logging, from the diner's client
        allow update, delete: if false;
      }
    }
  }
}
